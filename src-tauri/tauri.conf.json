{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RepoZero",
  "version": "0.0.2",
  "identifier": "com.xsijie.repozero",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RepoZero",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFGOTJGMjhCRTU5MEFDNDgKUldSSXJKRGxpL0tTSDgyNzJyck0rUzZ5dXFUamZzK2JKSERHSzBSMXZuc25MLzRRSmJURTRIVUwK",
      "endpoints": [
        "https://github.com/XSIJIE975/repo-zero/releases/latest/download/latest.json"
      ]
    }
  }
}
